{
  "issue": "1948-10",
  "scope": "Visually read starts of left columns, not full-page proofreading; some quotations start mid-word",
  "anchors": [
    {"page":37,"text":"Калай тышлы, авыр тупсалы ишекләргә"},
    {"page":38,"text":"чыккан бер солдатны күзеннән"},
    {"page":39,"text":"тиры турысына мичәп"},
    {"page":40,"text":"чыкты. Арттагы рәттә"},
    {"page":41,"text":"Бистә казармалары"},
    {"page":42,"text":"лаштырып тез башын учлады"},
    {"page":43,"text":"Вәлишиннәрнең күн заводында"},
    {"page":44,"text":"дәгә азан әйттеләр"},
    {"page":45,"text":"лыклы агымнар арасында сынауга"},
    {"page":46,"text":"кире шырлыкка кайтырга"},
    {"page":47,"text":"ияреп йөрмәсен. Без андыйларга"},
    {"page":48,"text":"һәм бил сызлый"},
    {"page":49,"text":"Барактагы бөтен лампалар"},
    {"page":50,"text":"нык тота икән"},
    {"page":51,"text":"Шулай да Бакчасарай"},
    {"page":52,"text":"Мөбарәкша, чана япкычының"},
    {"page":53,"text":"казлар килеп коеналар"},
    {"page":54,"text":"генә гыжлап йөткерә"},
    {"page":55,"text":"белән уралган озынча битле солдат"},
    {"page":56,"text":"Приготовиться"},
    {"page":57,"text":"на кебек ерып керде"},
    {"page":58,"text":"чытырдап ябышкан Ефремов"},
    {"page":59,"text":"да юк. Кешеләр даже үбешәләр"},
    {"page":60,"text":"телефон аша гафу үтенде"},
    {"page":61,"text":"Суфия үзенең атасы Юныс байны"},
    {"page":62,"text":"нарга, бер-берсен үртәшеп"},
    {"page":63,"text":"радный турысындагы ялангач юкә"},
    {"page":64,"text":"сез аның куркаклыгын белмичә"},
    {"page":65,"text":"тенә челтәрле боз катты"},
    {"page":66,"text":"бөгәрләнеп йоклаучы икенче бер"},
    {"page":67,"text":"Миңа шул хәтлесе билгеле"},
    {"page":68,"text":"вагон тәгәрмәчләре шыгырдадылар"},
    {"page":69,"text":"нуым өчен гафу итегез"},
    {"page":70,"text":"ган саен свисток черелдәве"},
    {"page":71,"text":"Суфия белән Горжецкий"},
    {"page":72,"text":"Бикләмишевкә инәлеп карады"},
    {"page":73,"text":"куе төтен туздырып янучы учак"}
  ]
}
